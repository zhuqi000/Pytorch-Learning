    "class My_Net(nn.Module):\n",
    "    def __init__(self, *args, **kwargs):\n",
    "        super().__init__(*args, **kwargs)\n",
    "        self.maxpool=nn.MaxPool2d(kernel_size=2,ceil_mode=True)\n",
    "    def forward (self,input):\n",
    "        return self.maxpool(input)"
